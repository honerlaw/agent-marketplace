{
  "skill": "work",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "work"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    "scratchpad.md",
    "proposal.md",
    "replan.md",
    ".minerva/work/",
    "minerva:replan",
    {
      "any_of": [
        "diverge",
        "divergence"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "resume",
        "left off"
      ],
      "ignore_case": true
    },
    "plugins/minerva/skills/propose/references/cross-session.md"
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
