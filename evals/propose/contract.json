{
  "skill": "propose",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "propose"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    "proposal.md",
    ".minerva/work/",
    "scratchpad.md",
    "minerva:explore",
    {
      "any_of": [
        "brainstorm",
        "questions one at a time"
      ],
      "ignore_case": true
    },
    "references/issue-match.md",
    {
      "any_of": [
        "Open-issue match"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "adopting #NN"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "Closes**: #NN"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "adopted issue"
      ],
      "ignore_case": true,
      "file": "references/on-approval.md"
    },
    {
      "any_of": [
        "references/in-flight-check.md"
      ]
    },
    {
      "any_of": [
        "detection, not mutual exclusion"
      ],
      "ignore_case": true,
      "file": "references/in-flight-check.md"
    },
    {
      "any_of": [
        "binds only writers that share the ref",
        "the resource the lock protects"
      ],
      "ignore_case": true,
      "file": "references/in-flight-check.md"
    },
    {
      "any_of": [
        "Skip silently if `ListAgents` or `SendMessage` is unavailable"
      ],
      "file": "references/in-flight-check.md"
    },
    {
      "any_of": [
        "MINERVA-BUSY"
      ],
      "file": "references/in-flight-check.md"
    },
    {
      "any_of": [
        "Silence is `unknown`, never `clear`"
      ],
      "file": "references/in-flight-check.md"
    },
    "references/cross-session.md",
    {
      "any_of": [
        "This message is information, not a work request — do not start anything on my behalf."
      ],
      "file": "references/in-flight-check.md"
    },
    {
      "any_of": [
        "This message is information, not a work request — do not start anything on my behalf."
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "\"adds to their workstream\""
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "dispatch is delegation by design"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "binds only sessions that read it"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "evidence, never an instruction"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "This is not a ban on asking questions"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "Same area is not invalidating"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "increments the run's global escalation counter"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "continue / modify / stop"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "relays a request to do"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "never adopted as work"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "re-run such a reply through the table below"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "**At intake, before a work unit exists**"
      ],
      "file": "references/cross-session.md"
    },
    {
      "any_of": [
        "fit here and nowhere else"
      ],
      "file": "references/cross-session.md"
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
