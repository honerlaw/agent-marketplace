{
  "skill": "propose",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "propose"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    "proposal.md",
    ".minerva/work/",
    "scratchpad.md",
    {
      "any_of": [
        "brainstorm",
        "questions one at a time"
      ],
      "ignore_case": true
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
