{
  "skill": "propose",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "propose"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    "proposal.md",
    ".minerva/work/",
    "scratchpad.md",
    "minerva:explore",
    {
      "any_of": [
        "brainstorm",
        "questions one at a time"
      ],
      "ignore_case": true
    },
    "references/issue-match.md",
    {
      "any_of": [
        "Open-issue match"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "adopting #NN"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "Closes**: #NN"
      ],
      "file": "references/issue-match.md"
    },
    {
      "any_of": [
        "adopted issue"
      ],
      "ignore_case": true,
      "file": "references/on-approval.md"
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
