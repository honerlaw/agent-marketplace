{
  "skill": "init",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "init"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    {
      "any_of": [
        ".minerva/work/"
      ],
      "file": "references/steps.md"
    },
    ".minerva/knowledge/",
    {
      "any_of": [
        ".gitkeep"
      ],
      "file": "references/steps.md"
    },
    ".gitignore",
    "CLAUDE.md",
    "AGENTS.md",
    {
      "any_of": [
        "overview.md"
      ],
      "file": "references/steps.md"
    },
    {
      "any_of": [
        "you may have customized it"
      ],
      "file": "references/steps.md"
    },
    {
      "any_of": [
        "Routing",
        "## minerva"
      ]
    },
    {
      "any_of": [
        "idempotent",
        "idempotency",
        "already initialized"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "flat layout",
        "mv work",
        "pre-existing"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        ".minerva/reference/"
      ],
      "file": "references/steps.md"
    },
    {
      "any_of": [
        "index.md"
      ],
      "file": "references/steps.md"
    },
    {
      "any_of": [
        "no watermark"
      ],
      "file": "references/steps.md"
    },
    {
      "any_of": [
        "backfill"
      ],
      "file": "references/steps.md",
      "ignore_case": true
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
