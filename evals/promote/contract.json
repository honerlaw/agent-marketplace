      "any_of": [
        "idempotent",
        "idempotency"
      ],
      "ignore_case": true
    },
    ".minerva/knowledge/",
    ".minerva/work/",
    {
      "any_of": [
        "new engineer",
        "year"
      ],
      "ignore_case": true
    },
    "## Related",
    "index-watermark",
    "[[",
    {
      "any_of": [
        "cross-reference",
        "cross-references",
        "wiki maintenance"
      ],
      "ignore_case": true
