{
  "skill": "ship",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "ship"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    {
      "any_of": [
        ".minerva/work/"
      ],
      "file": "references/protocol.md"
    },
    "proposal.md",
    {
      "any_of": [
        "gh pr create"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "gh pr merge --auto"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "git checkout -b"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "bare mode"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "3 iteration",
        "three iteration"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "auto-merge",
        "auto merge"
      ],
      "ignore_case": true
    },
    "minerva:promote",
    "minerva:review",
    {
      "any_of": [
        "most-recently-modified",
        "most recently modified"
      ],
      "ignore_case": true
    },
    "gh pr view",
    {
      "any_of": [
        "Default-branch detection",
        "default-branch detection"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "post-promote",
        "post-`minerva:promote`"
      ],
      "file": "references/protocol.md",
      "ignore_case": true
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
