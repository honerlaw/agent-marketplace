{
  "skill": "explore",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "explore"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    "one at a time",
    "writes no file",
    "minerva:propose",
    {
      "any_of": [
        "commitment-free",
        "terminal outcomes"
      ],
      "ignore_case": true
    },
    "plugins/minerva/skills/propose/references/issue-match.md"
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
