{
  "skill": "cleanup",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "cleanup"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    ".minerva/worktrees/",
    "merged",
    "default branch",
    {
      "any_of": [
        "No knowledge reconciliation"
      ]
    },
    {
      "any_of": [
        "derived on read"
      ],
      "ignore_case": true
    },
    {
      "any_of": [
        "opens no PR"
      ]
    },
    {
      "any_of": [
        "--dry-run"
      ]
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
