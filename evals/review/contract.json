{
  "skill": "review",
  "frontmatter": {
    "required_keys": [
      "name",
      "description"
    ],
    "values": {
      "name": "review"
    },
    "non_empty": [
      "description"
    ]
  },
  "anchors": [
    {
      "any_of": [
        ".minerva/work/"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "proposal.md"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "scratchpad.md"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "git diff",
        "git status"
      ],
      "file": "references/protocol.md"
    },
    "FIX",
    "SUGGEST",
    "IGNORE",
    "minerva:promote",
    {
      "any_of": [
        "minerva:replan"
      ],
      "file": "references/protocol.md"
    },
    {
      "any_of": [
        "most-recently-modified",
        "most recently modified"
      ],
      "ignore_case": true
    }
  ],
  "cross_surface": {
    "root_readme": true,
    "plugin_readme": true,
    "using_minerva_body": true
  }
}
