# Google credentials as one JSON object, either kind (see README "Credentials"):
#   a service account key:  {"type": "service_account", ...}
#   an OAuth user:          {"type": "authorized_user", "client_id": "...",
#                            "client_secret": "...", "refresh_token": "..."}
# Unset, the server uses Application Default Credentials.
GOOGLE_ADS_CREDENTIALS_JSON=

# The manager (MCC) account to act through, if any. Dashes are fine.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# GOOGLE_ADS_API_VERSION=v26
# GOOGLE_ADS_DISCOVERY_PATH=
# GOOGLE_ADS_TIMEOUT_SECONDS=120
# GOOGLE_ADS_MAX_RESPONSE_BYTES=2097152
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
