# A Meta system-user access token (see README "Getting a system-user token").
META_ADS_ACCESS_TOKEN=

# The Meta app the token was generated for. Set both or neither: with them every
# call is signed with appsecret_proof and meta_ads_token_status works.
META_APP_ID=
META_APP_SECRET=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# META_ADS_API_VERSION=v26.0
# META_ADS_SPEC_PATH=            (the image sets /app/specs; locally: make specs)
# META_ADS_TIMEOUT_SECONDS=120
# META_ADS_MAX_RESPONSE_BYTES=2097152
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
