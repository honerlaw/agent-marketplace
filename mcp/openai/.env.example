# Required: the OpenAI key every request is sent with.
OPENAI_API_KEY=sk-...

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_TIMEOUT_SECONDS=600
# OPENAI_MCP_MAX_BINARY_BYTES=20971520
# OPENAI_OPENAPI_PATH=
# OPENAI_OPENAPI_URL=https://raw.githubusercontent.com/openai/openai-openapi/manual_spec/openapi.yaml
# MCP_MAX_REQUEST_BYTES=67108864
# MCP_ALLOW_UNAUTHENTICATED=false
