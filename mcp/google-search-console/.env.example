# Google credentials: a service-account key or an authorized-user JSON, inline.
# Leave unset to use Application Default Credentials instead
# (GOOGLE_APPLICATION_CREDENTIALS, gcloud ADC, or the GCP metadata server).
GSC_CREDENTIALS_JSON=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# Request the read-only scope and hide the four tools that change properties or sitemaps.
# GSC_READ_ONLY=false
# GSC_TIMEOUT_SECONDS=120
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
