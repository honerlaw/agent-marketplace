# Dummy, non-secret values that let the image start for CI's /healthz smoke
# test (.github/workflows/mcp.yml). Startup only validates them; the server
# reaches R2 only when r2_list_uploads runs.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_BUCKET=ci-bucket
R2_ACCESS_KEY_ID=ci
R2_SECRET_ACCESS_KEY=ci
MCP_AUTH_TOKEN=ci
