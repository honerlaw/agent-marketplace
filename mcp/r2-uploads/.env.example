# The bucket, from an R2 API token scoped to it (Object Read & Write).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# R2_UPLOAD_EXPIRES_SECONDS=900
# R2_DOWNLOAD_EXPIRES_SECONDS=86400
# The bucket's public custom domain; adds an unsigned public_url to every result. Connecting
# that domain is what makes every object readable by anyone who knows its key; this setting
# only names it.
# R2_PUBLIC_BASE_URL=https://files.example.com
# R2_TIMEOUT_SECONDS=30
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
