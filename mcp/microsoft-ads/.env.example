# Your Microsoft Entra app registration (see README "Credentials"). A Web app has a
# client secret; a mobile/desktop (public) app has none: leave the secret empty.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
# From the one-time consent flow in the README. Microsoft rotates it on every refresh;
# the server keeps the new one in memory only, so re-issue this one before it expires.
MICROSOFT_ADS_REFRESH_TOKEN=
# From the Microsoft Advertising Developer Portal (sandbox: BBD37VB98).
MICROSOFT_ADS_DEVELOPER_TOKEN=

# Default CustomerId / CustomerAccountId headers; each tool call can override them.
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCOUNT_ID=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# MICROSOFT_ADS_ENVIRONMENT=production   # or sandbox
# MICROSOFT_ADS_TENANT=common            # organizations, consumers, a tenant GUID or domain
# MICROSOFT_ADS_DOWNLOAD_HOSTS=blob.core.windows.net,bingads.microsoft.com
# MICROSOFT_ADS_TIMEOUT_SECONDS=120
# MICROSOFT_ADS_MAX_RESPONSE_BYTES=2097152
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
