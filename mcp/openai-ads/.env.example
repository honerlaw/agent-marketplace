# Required: the Advertiser API key every request is sent with. Create one per
# ad account under Settings in OpenAI Ads Manager.
OPENAI_ADS_API_KEY=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
# OPENAI_ADS_TIMEOUT_SECONDS=120
# OPENAI_ADS_OPENAPI_PATH=
# OPENAI_ADS_OPENAPI_URL=https://developers.openai.com/ads/openapi.json
# MCP_MAX_REQUEST_BYTES=67108864
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
