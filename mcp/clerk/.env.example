# Required: the Clerk instance's secret key (Clerk Dashboard -> API Keys).
# sk_live_... is production, sk_test_... is development. It is not scoped:
# it can do everything the Backend API can on that instance.
CLERK_SECRET_KEY=

# Required in http mode (the Docker default): clients must send
# "Authorization: Bearer <this value>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional
# Refuse every method but GET before anything is sent.
# CLERK_READ_ONLY=false
# CLERK_TIMEOUT_SECONDS=60
# MCP_MAX_REQUEST_BYTES=4194304
# MCP_ALLOW_UNAUTHENTICATED=false
# Serve http mode without sessions, for hosts that stop idle instances or
# several replicas behind a load balancer.
# MCP_STATELESS=false
